# =============================================================================
# AQQIP Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=aqqip_root_pass
MYSQL_DATABASE=aqqip
MYSQL_USER=aqqip_user
MYSQL_PASSWORD=aqqip_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- MongoDB ---
MONGO_INITDB_DATABASE=aqqip_raw
MONGO_HOST=mongodb
MONGO_PORT=27017

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_BACKEND_STORE_URI=sqlite:///mlruns/mlflow.db

# --- Google Gemini (Free Tier) ---
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# --- Ollama (Local LLM) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=phi4-mini

# --- SEC EDGAR ---
# REQUIRED: Provide a compliant User-Agent per SEC guidelines
# Format: "AppName contact@example.com"
EDGAR_USER_AGENT=AQQIP research-bot contact@example.com

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Prediction Target ---
PREDICTION_HORIZON_TRADING_DAYS=20
SHARP_DROP_THRESHOLD_PCT=10.0
PRICE_FIELD_FOR_OUTCOME=adj_close

# --- MARL Defaults ---
MARL_EPISODE_LENGTH=20
MARL_DEFAULT_SEED=42

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
